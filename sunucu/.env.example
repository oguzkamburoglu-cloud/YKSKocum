# AI Koçum — sunucu gizli degerleri
# ---------------------------------------------------------------
# Bu dosyayi .env adiyla KOPYALA ve degerleri SEN doldur. .env asla
# depoya girmez, kimseye gonderilmez (.gitignore'da).
#   cp .env.example .env && nano .env
# Rastgele deger uretmek icin:  openssl rand -hex 32

# --- Veritabani (MariaDB container ve PHP ayni degerleri okur) ---
MARIADB_ROOT_PASSWORD=DEGISTIR_root_icin_uzun_rastgele
MARIADB_DATABASE=aikocum
MARIADB_USER=aikocum
MARIADB_PASSWORD=DEGISTIR_uzun_rastgele
DB_HOST=db

# --- Uygulama ---
# Oturum/imza gizli anahtari (64 hex):  openssl rand -hex 32
APP_SECRET=DEGISTIR_64_hex_karakter
APP_ENV=production

# --- Web Push / VAPID (Dilim 3'te doldurulacak, simdilik bos) ---
VAPID_PUBLIC=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:destek@aikocum.com.tr
